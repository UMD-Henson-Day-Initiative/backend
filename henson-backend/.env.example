
# Flask settings
FLASK_APP=autoapp.py
FLASK_DEBUG=0
FLASK_ENV=production

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/postgres?sslmode=require
# Supabase configuration
# SUPABASE_KEY must be the secret key (server-side only, bypasses RLS) —
# never expose it to the iOS app. Project token verification (app/auth.py)
# uses Supabase's JWKS endpoint derived from SUPABASE_URL, so no separate
# JWT secret is needed here.
SUPABASE_URL=url
SUPABASE_KEY=key
SECRET_KEY=secret

# Shared password for the /admin event-management page. Anyone with this
# password can add/edit/delete events — keep it out of chat, docs, etc.
ADMIN_PASSWORD=change-me

# Gunicorn settings
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=4
LOG_LEVEL=info

SEND_FILE_MAX_AGE_DEFAULT = 0

# CORS settings
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
